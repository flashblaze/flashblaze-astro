---
import {
  blogNode,
  personNode,
  websiteNode,
  WEBSITE_ID,
} from '../../constants/schema';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteNode,
    personNode,
    { ...blogNode, isPartOf: { '@id': WEBSITE_ID } },
  ],
};
---

<script type='application/ld+json' set:html={JSON.stringify(schema)} />
