---
import {
  blogNode,
  PERSON_ID,
  personNode,
  websiteNode,
  WEBSITE_ID,
} from '../../constants/schema';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...blogNode,
      author: { '@id': PERSON_ID },
      publisher: { '@id': PERSON_ID },
      isPartOf: { '@id': WEBSITE_ID },
      inLanguage: 'en',
    },
    personNode,
    websiteNode,
  ],
};
---

<script type='application/ld+json' set:html={JSON.stringify(schema)} />
